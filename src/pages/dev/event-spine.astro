---
import Layout from '@/layouts/Layout.astro'
import EventSpineHarness from '@/components/EventSpineHarness'

// Dev-only verification surface for the event spine. Disabled in production
// builds so it never becomes a shipped product route.
const isProd = import.meta.env.PROD
---

<Layout title="Event Spine — Dev Harness">
	<div id="container">
		<h1>Event Spine — Dev Harness</h1>
		{
			isProd ? (
				<p data-testid="dev-disabled">Dev harness disabled in production.</p>
			) : (
				<EventSpineHarness client:only="react" />
			)
		}
	</div>
</Layout>

<style>
	#container {
		width: 60%;
		margin: 3rem auto 0;
	}
</style>

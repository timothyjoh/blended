---
import Layout from '../../layouts/Layout.astro'

type MockupLink = {
  number: string
  href: string
  title: string
  description: string
}

const teacherMockups: MockupLink[] = [
  { number: '01', href: '/mockups/teacher/01', title: 'Resource command deck', description: 'Active resource centered between run-of-show controls and AI question pressure.' },
  { number: '02', href: '/mockups/teacher/02', title: 'Question triage board', description: 'AI-ranked clusters replace raw chat when the teacher needs answerable themes.' },
  { number: '03', href: '/mockups/teacher/03', title: 'Heatmap presenter', description: 'Cursor-voting overlay shows where students are stuck on the live resource.' },
  { number: '04', href: '/mockups/teacher/04', title: 'Resource queue rehearsal', description: 'Pre-class/live control room for embed checks, pacing, and session launch.' },
  { number: '05', href: '/mockups/teacher/05', title: 'Replay artifact review', description: 'Event-stream review of resources, questions, answers, and saved cursor summaries.' },
  { number: '06', href: '/mockups/teacher/06', title: 'Teacher command center', description: 'Dense facilitation cockpit for switching resources and watching classroom signals.' },
  { number: '07', href: '/mockups/teacher/07', title: 'Slide-first stage', description: 'Presentation-forward layout with lightweight rails for queue and participant pulse.' },
  { number: '08', href: '/mockups/teacher/08', title: 'Replay/event timeline', description: 'Timeline-led view for jumping through the event-sourced session record.' },
  { number: '09', href: '/mockups/teacher/09', title: 'Question cockpit', description: 'Cluster, moderation, and answer workflow for live seminar-style teaching.' },
  { number: '10', href: '/mockups/teacher/10', title: 'Minimal presentation mode', description: 'Low-chrome stage with hidden telemetry for active resource delivery.' },
]

const studentMockups: MockupLink[] = [
  { number: '01', href: '/mockups/student/01', title: 'Mobile chat-first', description: 'Phone-first session chat with surfaced questions and active resource context.' },
  { number: '02', href: '/mockups/student/02', title: 'Resource-first learner', description: 'The teacher-selected resource leads while chat and questions stay available.' },
  { number: '03', href: '/mockups/student/03', title: 'Question board', description: 'Student-visible clusters encourage anonymous upvotes instead of duplicate questions.' },
  { number: '04', href: '/mockups/student/04', title: 'Cursor vote active', description: 'Participation mode for hovering over confusing regions of the live resource.' },
  { number: '05', href: '/mockups/student/05', title: 'Answered/replay aware', description: 'Answered clusters stay visible so distracted or late students can catch up.' },
  { number: '06', href: '/mockups/student/06', title: 'Tablet learning desk', description: 'Split workspace for resource, discussion, and session signals on larger screens.' },
  { number: '07', href: '/mockups/student/07', title: 'Phone focus mode', description: 'Compact resource-first mobile experience with minimal interruption.' },
  { number: '08', href: '/mockups/student/08', title: 'Cluster-first student view', description: 'Prioritizes open/answered question clusters over raw message chronology.' },
  { number: '09', href: '/mockups/student/09', title: 'Cursor-vote prompt', description: 'Active prompt interface for placing a translucent attention marker.' },
  { number: '10', href: '/mockups/student/10', title: 'Replay catch-up', description: 'Student recap built from session events, resources, and answer summaries.' },
]

const sections = [
  {
    eyebrow: 'Teacher / presenter',
    title: 'Facilitation surfaces',
    description: 'Ten different ways to run a bounded live learning session: resource control, AI triage, cursor voting, and replay evidence.',
    accent: 'from-sky-400 to-violet-500',
    links: teacherMockups,
  },
  {
    eyebrow: 'Student / chat',
    title: 'Learner participation surfaces',
    description: 'Ten different ways students can follow the active resource, ask naturally, upvote clusters, vote with cursors, and catch up after answers.',
    accent: 'from-emerald-400 to-cyan-500',
    links: studentMockups,
  },
]
---

<Layout>
  <section class="min-h-screen bg-slate-950 px-6 py-12 font-sans text-slate-100 sm:px-8 lg:px-12">
    <div class="mx-auto flex w-full max-w-7xl flex-col gap-10">
      <header class="overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.04] shadow-2xl shadow-slate-950/30 backdrop-blur">
        <div class="grid gap-8 p-8 md:grid-cols-[1fr_320px] md:p-10">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.35em] text-cyan-300/80">Blended mockup lab</p>
            <h1 class="m-0 max-w-4xl py-5 font-sans text-5xl font-black tracking-tight !text-white md:text-7xl">
              Twenty routes for pressure-testing the live classroom interface.
            </h1>
            <p class="max-w-3xl text-base leading-7 text-slate-300">
              These are divergent static prototypes for the hackathon slice: teacher-controlled resources, student chat, AI-ranked question clusters, cursor-voting, and replayable event streams. Not a chat app. Not a video-call clone. A live session system.
            </p>
          </div>
          <div class="grid content-end gap-3 rounded-3xl border border-white/10 bg-slate-900/80 p-5">
            <div class="text-5xl font-black text-white">20</div>
            <div class="text-sm text-slate-300">mockups under <code class="rounded bg-white/10 px-2 py-1">/mockups</code></div>
            <div class="grid grid-cols-2 gap-2 text-sm">
              <a class="rounded-2xl bg-white px-4 py-3 text-center font-bold text-slate-950" href="/mockups/teacher/01">Teacher 01</a>
              <a class="rounded-2xl bg-cyan-300 px-4 py-3 text-center font-bold text-slate-950" href="/mockups/student/01">Student 01</a>
            </div>
          </div>
        </div>
      </header>

      {sections.map((section) => (
        <section class="rounded-[2rem] border border-white/10 bg-white/[0.04] p-6 shadow-xl shadow-black/20 md:p-8">
          <div class="mb-6 flex flex-col justify-between gap-4 md:flex-row md:items-end">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-400">{section.eyebrow}</p>
              <h2 class="m-0 py-2 font-sans text-3xl font-black text-white md:text-4xl">{section.title}</h2>
              <p class="max-w-3xl text-sm leading-6 text-slate-300">{section.description}</p>
            </div>
            <div class={`h-2 w-40 rounded-full bg-gradient-to-r ${section.accent}`}></div>
          </div>
          <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-5">
            {section.links.map((link) => (
              <a href={link.href} class="group rounded-3xl border border-white/10 bg-slate-900/70 p-5 transition hover:-translate-y-1 hover:border-cyan-300/50 hover:bg-slate-900 hover:shadow-2xl hover:shadow-cyan-950/30">
                <div class="mb-6 flex items-center justify-between">
                  <span class="grid h-11 w-11 place-items-center rounded-2xl bg-white text-sm font-black text-slate-950">{link.number}</span>
                  <span class="text-sm text-slate-500 transition group-hover:text-cyan-300">Open →</span>
                </div>
                <h3 class="font-sans text-lg font-black text-white">{link.title}</h3>
                <p class="mt-2 text-sm leading-6 text-slate-400">{link.description}</p>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</Layout>

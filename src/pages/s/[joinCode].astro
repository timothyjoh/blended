---
import Layout from '@/layouts/Layout.astro'
import RouteGuard from '@/components/RouteGuard'
import StudentSession from '@/components/StudentSession'
import StudentChat from '@/components/StudentChat'

// Student session view (cycle 0007). Mounts the live-syncing `StudentSession`
// island inside the shared `RouteGuard`, so only an authenticated student reaches
// it (the `/join/<code>` flow routes here after the join commits). Astro already
// has the route param; pass it straight to the `client:only` island. Default to
// '' so the prop is a definite string (an empty code resolves to the island's
// not-found state).
const { joinCode = '' } = Astro.params
---

<Layout title="Session — Blended">
  <div class="mx-auto mt-12 w-full max-w-2xl px-4">
    <RouteGuard client:only="react">
      <StudentSession client:only="react" joinCode={joinCode} />
      <StudentChat client:only="react" joinCode={joinCode} />
    </RouteGuard>
  </div>
</Layout>

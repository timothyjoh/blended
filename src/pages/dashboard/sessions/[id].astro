---
import Layout from '@/layouts/Layout.astro'
import SessionRouteGuard from '@/components/SessionRouteGuard'
import SessionLifecycle from '@/components/SessionLifecycle'

// Ownership-scoped session detail (cycle 0004 guard + cycle 0006 lifecycle). The
// owning teacher reaches the `SessionLifecycle` island, which reflects status and
// the join gate and drives Start/End. Astro already has the route param, so pass
// it straight to the `client:only` islands rather than re-parsing the URL.
// Astro types route params as possibly-undefined; the `[id]` segment is always
// present at runtime, but default to '' so the island prop is a definite string
// (an empty id resolves to the guard's denial state, never the protected shell).
const { id = '' } = Astro.params
---

<Layout title="Session — Blended">
  <div class="mx-auto mt-12 w-full max-w-2xl px-4">
    <SessionRouteGuard client:only="react" sessionId={id}>
      <SessionLifecycle client:only="react" sessionId={id} />
    </SessionRouteGuard>
  </div>
</Layout>

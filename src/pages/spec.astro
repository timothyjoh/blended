---
import Layout from '../layouts/Layout.astro'
import { marked } from 'marked'
import specMarkdown from '../../docs/SPEC.md?raw'

marked.use({
  gfm: true,
  breaks: false,
})

const specHtml = await marked.parse(specMarkdown)
const lastUpdatedMatch = specMarkdown.match(/\*\*Last updated:\*\*\s*([^\n]+)/)
const statusMatch = specMarkdown.match(/\*\*Status:\*\*\s*([^\n]+)/)
const lastUpdated = lastUpdatedMatch?.[1]?.trim() ?? 'Unknown'
const status = statusMatch?.[1]?.trim() ?? 'Draft'
---

<Layout title="Blended Specification">
  <section class="min-h-screen bg-slate-950 px-5 py-10 text-slate-100 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-5xl">
      <header class="mb-8 rounded-[2rem] border border-cyan-300/20 bg-white/[0.04] p-7 shadow-2xl shadow-cyan-950/20 backdrop-blur md:p-10">
        <p class="text-xs font-bold uppercase tracking-[0.35em] text-cyan-300/80">Blended specification</p>
        <h1 class="m-0 py-4 font-sans text-4xl font-black tracking-tight !text-white md:text-6xl">Product and technical spec</h1>
        <p class="max-w-3xl text-base leading-7 text-slate-300">
          Rendered from <code class="rounded bg-white/10 px-2 py-1 text-cyan-100">docs/SPEC.md</code>. This page exists so the Markdown spec can be reviewed as readable HTML without maintaining a second copy.
        </p>
        <dl class="mt-6 grid gap-3 text-sm text-slate-300 md:grid-cols-2">
          <div class="rounded-2xl border border-white/10 bg-slate-900/70 p-4">
            <dt class="text-xs uppercase tracking-[0.25em] text-slate-500">Status</dt>
            <dd class="mt-2 font-semibold text-white">{status}</dd>
          </div>
          <div class="rounded-2xl border border-white/10 bg-slate-900/70 p-4">
            <dt class="text-xs uppercase tracking-[0.25em] text-slate-500">Last updated</dt>
            <dd class="mt-2 font-semibold text-white">{lastUpdated}</dd>
          </div>
        </dl>
      </header>

      <article class="spec-document rounded-[2rem] border border-white/10 bg-slate-50 px-5 py-7 text-slate-900 shadow-2xl shadow-black/20 md:px-10 md:py-12" set:html={specHtml} />
    </div>
  </section>
</Layout>

<style is:global>
  .spec-document {
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .spec-document :where(h1, h2, h3, h4) {
    color: #020617;
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  .spec-document h1 {
    margin: 0 0 1.5rem;
    font-size: clamp(2.25rem, 8vw, 4.75rem);
  }

  .spec-document h2 {
    margin: 3rem 0 1rem;
    border-top: 1px solid #cbd5e1;
    padding-top: 1.75rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .spec-document h3 {
    margin: 2rem 0 0.75rem;
    font-size: 1.45rem;
  }

  .spec-document h4 {
    margin: 1.5rem 0 0.5rem;
    font-size: 1.1rem;
  }

  .spec-document p,
  .spec-document li,
  .spec-document td,
  .spec-document th {
    line-height: 1.75;
  }

  .spec-document p {
    margin: 0.85rem 0;
  }

  .spec-document a {
    color: #0369a1;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .spec-document ul,
  .spec-document ol {
    margin: 0.75rem 0 1.25rem 1.5rem;
    padding: 0;
  }

  .spec-document li + li {
    margin-top: 0.35rem;
  }

  .spec-document blockquote {
    margin: 1.5rem 0;
    border-left: 5px solid #06b6d4;
    background: #ecfeff;
    padding: 1rem 1.25rem;
    color: #164e63;
    font-weight: 700;
  }

  .spec-document code {
    border-radius: 0.4rem;
    background: #e2e8f0;
    padding: 0.12rem 0.35rem;
    color: #0f172a;
    font-family: "Fira Code", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.92em;
  }

  .spec-document pre {
    overflow-x: auto;
    border-radius: 1rem;
    background: #020617;
    padding: 1rem;
    color: #e2e8f0;
  }

  .spec-document pre code {
    background: transparent;
    padding: 0;
    color: inherit;
  }

  .spec-document table {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 1.25rem 0 2rem;
    border-radius: 0.9rem;
    box-shadow: 0 0 0 1px #cbd5e1;
  }

  .spec-document th,
  .spec-document td {
    border: 1px solid #cbd5e1;
    padding: 0.7rem 0.9rem;
    vertical-align: top;
  }

  .spec-document th {
    background: #e0f2fe;
    text-align: left;
    color: #0f172a;
  }

  .spec-document tr:nth-child(even) td {
    background: #f8fafc;
  }

  .spec-document hr {
    margin: 2.5rem 0;
    border: none;
    border-top: 1px solid #cbd5e1;
  }
</style>

PUBLIC_INSTANTDB_APP_ID=your-instantdb-app-id

# e2e-only: InstantDB admin token used by the Playwright auth suite to mint
# deterministic magic codes (via @instantdb/admin generateMagicCode — no email
# is sent). NEVER used by client/product code. When unset, e2e/auth.spec.ts
# skips loudly instead of passing falsely.
INSTANT_ADMIN_TOKEN=

# SERVER-ONLY (cycle 0019, ADR-0003): a comma/whitespace-separated allowlist of
# emails bootstrapped to the global `uber` admin level on sign-in. NO `PUBLIC_`
# prefix — it must NEVER reach the client bundle. The elevated write happens only
# server-side via `/api/admin/bootstrap` (the admin SDK, which bypasses the
# permission rules); a client can never write its own `adminLevel`. An EMPTY or
# unset value means NO admins are bootstrapped. Case-insensitive; entries are
# trimmed + lowercased. The admin-route e2e (`e2e/admin-route.spec.ts`) and the
# cycle walkthrough use the deterministic `admin@blended.test`.
ADMIN_EMAILS=

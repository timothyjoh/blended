# Required for the app AND for the deploy-prerequisite pushes: both
# `npm run schema:push` and `npm run perms:push` resolve this app id BEFORE any
# network call and fail loudly (non-zero) when it is missing/empty. The live
# schema-verification e2e (`e2e/schema-push.spec.ts`) additionally needs
# INSTANTDB_ADMIN_TOKEN (below) and skips loudly without it.
PUBLIC_INSTANTDB_APP_ID=your-instantdb-app-id

# Server-only InstantDB admin token. Used by API routes that need the admin SDK
# (`/api/admin/bootstrap`, optional developer login) and by Playwright suites to
# mint deterministic magic codes without email. Never expose it with a PUBLIC_
# prefix.
INSTANTDB_ADMIN_TOKEN=

# SERVER-ONLY (cycle 0019, ADR-0003): a comma/whitespace-separated allowlist of
# emails bootstrapped to the global `uber` admin level on sign-in. NO `PUBLIC_`
# prefix — it must NEVER reach the client bundle. The elevated write happens only
# server-side via `/api/admin/bootstrap` (the admin SDK, which bypasses the
# permission rules); a client can never write its own `adminLevel`. An EMPTY or
# unset value means NO admins are bootstrapped. Case-insensitive; entries are
# trimmed + lowercased. The admin-route e2e (`e2e/admin-route.spec.ts`) and the
# cycle walkthrough use the deterministic `admin@blended.test`.
ADMIN_EMAILS=

# Temporary developer-login bypass for environments without email delivery.
# Leave disabled unless you intentionally want `/login` to show the developer
# sign-in controls. The UI sends DEV_LOGIN_SECRET to the server endpoint, which
# uses INSTANTDB_ADMIN_TOKEN to mint a real InstantDB magic code without email.
# DEV_LOGIN_SECRET is server-only; use a high-entropy value and rotate/remove it
# once real email delivery is configured.
PUBLIC_DEV_LOGIN_ENABLED=false
DEV_LOGIN_SECRET=
